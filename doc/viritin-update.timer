[Unit]
Description=Check for a new Viritin release daily
Documentation=https://github.com/ollisulopuisto/viritin/blob/master/doc/APPLIANCE.md

[Timer]
OnCalendar=*-*-* 04:30:00
# Spread the load on the release host, and stop every appliance in the world
# asking at the same second.
RandomizedDelaySec=30m
# A box that was switched off at 04:30 checks when it next comes up, rather than
# waiting a whole day. An appliance is not always on.
Persistent=true

[Install]
WantedBy=timers.target
